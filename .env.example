# Copie para .env e preencha antes de subir:  cp .env.example .env

# --- Banco ---
POSTGRES_DB=fdsmartcheck
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Seguranca (gere com: openssl rand -base64 48) ---
JWT_SECRET=
APP_GEO_SECRET_KEY=

# Expiracao do token em MILISSEGUNDOS (36000000 = 10 horas)
JWT_EXPIRATION=36000000

# --- Front ---
# Origens liberadas no CORS, separadas por virgula. Aceita curinga.
APP_CORS_ALLOWED_ORIGINS=https://seu-projeto.vercel.app,https://*.vercel.app

# --- Admin inicial (criado so na primeira subida, se nao houver nenhum ADMIN) ---
APP_ADMIN_NAME=Administrador
APP_ADMIN_EMAIL=admin@sua-faculdade.br
# Deixe em branco para o sistema gerar uma senha aleatoria e mostrar no log:
#   docker compose logs api | grep -A5 "ADMIN INICIAL"
APP_ADMIN_PASSWORD=

# --- Opcionais ---
API_PORT=8080
APP_TIMEZONE=America/Sao_Paulo
